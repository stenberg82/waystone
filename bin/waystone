#!/usr/bin/env python3
"""Run Waystone from a source checkout or an installed location."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for candidate in (os.path.join(here, ".."), os.path.join(here, "..", "lib", "waystone")):
    if os.path.isdir(os.path.join(candidate, "waystone")):
        sys.path.insert(0, os.path.abspath(candidate))
        break

from waystone.app import main  # noqa: E402

sys.exit(main())
